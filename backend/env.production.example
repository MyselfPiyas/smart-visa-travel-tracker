# Configure these only in the Render service dashboard, never in source control.
NODE_ENV=production
PORT=10000
MONGODB_URI=mongodb+srv://<production-user>:<password>@<cluster-host>/<production-database>?retryWrites=true&w=majority&authSource=admin
JWT_SECRET=<generate-at-least-32-random-characters>
JWT_EXPIRES_IN=30m
FRONTEND_ORIGIN=https://<your-vercel-domain>
AUTH_COOKIE_SAME_SITE=none
AUTH_COOKIE_SECURE=true
AUTH_RATE_LIMIT=10
TRUST_PROXY_HOPS=1

# Render persistent disk is private and mounted only into the API service.
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_LOCAL_STORAGE_PATH=/var/data/private_uploads
DOCUMENT_ENCRYPTION_KEY=<generate-64-hex-characters-and-store-as-a-host-secret>
DOCUMENT_MAX_FILE_SIZE_MB=10
DOCUMENT_MAX_FILES_PER_DOCUMENT=5
REMINDER_WORKER_ENABLED=false

# Configure only in the separate persistent worker service.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=<verified-sender-address>
APP_BASE_URL=https://<your-vercel-domain>
REMINDER_WORKER_ENABLED=true
REMINDER_SCAN_INTERVAL_MS=900000
REMINDER_POLL_INTERVAL_MS=60000
REMINDER_BATCH_SIZE=50
REMINDER_MAX_ATTEMPTS=5
