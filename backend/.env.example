PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority&authSource=admin
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
DOCUMENT_EXPIRY_WARNING_DAYS=90,60,30
JWT_SECRET=replace-with-at-least-32-random-secret-characters
JWT_EXPIRES_IN=30m
AUTH_COOKIE_SAME_SITE=strict
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT=10
BCRYPT_SALT_ROUNDS=12
TRUST_PROXY_HOPS=0
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_LOCAL_STORAGE_PATH=./private_uploads
DOCUMENT_ENCRYPTION_KEY=<generate-64-hex-characters>
DOCUMENT_MAX_FILE_SIZE_MB=10
DOCUMENT_MAX_FILES_PER_DOCUMENT=5
APP_BASE_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Smart Visa Tracker <no-reply@example.com>
REMINDER_WORKER_ENABLED=true
REMINDER_SEND_HOUR=9
REMINDER_SCAN_INTERVAL_MS=900000
REMINDER_POLL_INTERVAL_MS=60000
REMINDER_BATCH_SIZE=50
REMINDER_MAX_ATTEMPTS=5
REMINDER_RETRY_BASE_MS=300000
REMINDER_RETRY_MAX_MS=21600000
REMINDER_PROCESSING_LEASE_MS=600000
REMINDER_EXPIRED_WINDOW_DAYS=365
DESTINATION_REQUIREMENT_STALE_DAYS=180
# Set these only in your shell/environment when running `npm run seed:admin`.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
